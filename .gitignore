# Bỏ qua thư mục chứa thư viện (Rất quan trọng vì nó rất nặng)
node_modules/

# Bỏ qua thư mục build production
/dist
/dist-ssr

# Bỏ qua các file log hệ thống
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Bỏ qua các file môi trường local (chứa các API key hoặc config riêng của máy dev)
.env.local
.env.*.local

# Bỏ qua các file cấu hình của IDE/Editor (VS Code, WebStorm, v.v.)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Bỏ qua file rác của hệ điều hành
.DS_Store
Thumbs.db

# --- CÁC FILE LOCK (Hãy đọc kỹ lưu ý bên dưới) ---
package-lock.json
yarn.lock
pnpm-lock.yaml